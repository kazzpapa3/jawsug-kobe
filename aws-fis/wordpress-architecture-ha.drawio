        <!-- Key Features -->
        <mxCell id="features" value="High Availability Features:&#xa;• Application Load Balancer (Multi-AZ)&#xa;• Auto Scaling Group (2-4 instances)&#xa;• EC2 instances in Private Subnets&#xa;• Aurora Serverless v2 (Multi-AZ)&#xa;• NAT Gateway for outbound internet&#xa;• VPC Endpoints for AWS services&#xa;• Cross-AZ redundancy" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
